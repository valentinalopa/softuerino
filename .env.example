# Sviluppo locale: SQLite su file.
DATABASE_URL="file:./dev.db"

# Produzione (Vercel/Turso): se impostate e non vuote, l'adapter libSQL usa Turso
# al posto di DATABASE_URL. Su Vercel sono configurate come variabili d'ambiente cifrate.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opzionali: credenziali del primo Super Admin creato dal seed (Valentina Loparco).
# Se non impostate (o vuote), il seed usa v.loparco@colibrivision.it / changeme123.
# Il seed è solo per sviluppo: con NODE_ENV=production si rifiuta di partire.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Chiave per cifrare i segreti salvati nel database (es. password SMTP),
# 32 byte in base64. Generala una volta e non cambiarla: con una chiave
# diversa la password SMTP salvata non è più leggibile e va reinserita.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Login con Keycloak (OpenID Connect). Se impostate tutte e quattro, nella
# pagina di login compare "Accedi con l'account aziendale" e il login con
# password resta solo ai super admin (accesso di emergenza).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI: uno per ogni nome dell'app, separati da virgola, es.
#   https://interno.esempio.it/api/auth/oidc/callback,https://pubblico.esempio.it/api/auth/oidc/callback
# (si usa quello del nome della richiesta; registrarli tutti su Keycloak).
OIDC_REDIRECT_URI=
# Opzionale: gruppo Keycloak (claim "groups") richiesto per entrare. I nuovi
# utenti vengono creati al primo login come membri.
OIDC_ALLOWED_GROUP=
