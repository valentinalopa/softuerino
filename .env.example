# Sviluppo locale: SQLite su file.
DATABASE_URL="file:./dev.db"

# Produzione (Vercel/Turso): se impostate, l'adapter libSQL usa Turso al posto
# di DATABASE_URL. Su Vercel sono configurate come variabili d'ambiente cifrate.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opzionali: credenziali del primo Super Admin creato dal seed (Valentina Loparco).
# Se non impostate, il seed usa v.loparco@colibrivision.it / changeme123 (solo sviluppo).
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
