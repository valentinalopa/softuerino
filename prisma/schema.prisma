// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Membro del team
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("membro") // super_admin | membro (da non confondere con employmentType)
  employmentType String   @default("dipendente") // dipendente | partita_iva
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  sessions        Session[]
  leaveRequests   LeaveRequest[]
  events          EventParticipant[]
  createdEvents   CalendarEvent[]
  presenceEntries PresenceEntry[]
  timeEntries     TimeEntry[]
  taskAssignments TaskAssignee[]
  pedAssignments  PedContent[]
}

// Sessione di login: token opaco in cookie httpOnly, riga cancellabile per logout/revoca
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Richiesta di ferie / permesso / malattia
model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  type      String // ferie | permesso | malattia
  startDate DateTime
  endDate   DateTime
  hours     Float? // valorizzato solo per type = "permesso"
  status    String   @default("pending") // pending | approved | rejected | registrata
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate, endDate])
}

// Evento di calendario: riunione di team, shooting, altro
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  type        String // riunione | shooting | altro
  startAt     DateTime
  endAt       DateTime
  location    String?
  description String?
  createdById String? // chi ha creato l'evento può sempre gestirlo, anche se non partecipa
  createdAt   DateTime @default(now())

  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  participants EventParticipant[]
}

// Join table partecipanti evento <-> utenti
model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// Autodichiarazione giornaliera di presenza (ufficio/smartworking), senza approvazione
model PresenceEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  slot      String // mattina | pomeriggio | giornata_intera
  mode      String // ufficio | smartworking
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, slot])
}

// Cliente = progetto (1:1 per ora)
model Client {
  id         String   @id @default(cuid())
  name       String   @unique
  active     Boolean  @default(true)
  categories String   @default("") // CSV di categorie: comunicazione | it_design | produzione ("comunicazione" abilita il PED)
  createdAt  DateTime @default(now())

  timeEntries TimeEntry[]
  tasks       Task[]
  pedContents PedContent[]
}

// Contenuto del piano editoriale (PED) di un cliente: post/clip pianificati
// sul calendario, con stato di produzione e social di destinazione.
model PedContent {
  id         String   @id @default(cuid())
  clientId   String
  title      String
  date       DateTime // giorno di pubblicazione previsto
  status     String   @default("idea") // idea | in_lavorazione | programmato | pubblicato
  socials    String // CSV di social (es. "instagram,tiktok"): SQLite non ha array
  script     String? // testo/idea/script del contenuto
  assigneeId String? // responsabile (opzionale)
  createdAt  DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee User?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([clientId, date])
  @@index([date])
}

// Log ore lavorate su un cliente/progetto
model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  date        DateTime
  hours       Float
  description String
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([clientId])
}

// Task assegnato a uno o più membri del team, opzionalmente legato a un cliente
model Task {
  id          String    @id @default(cuid())
  title       String
  clientId    String?
  status      String    @default("not_started") // not_started | in_progress | in_pausa | done
  priority    String? // low | medium | high
  dueDate     DateTime?
  completedAt DateTime? // valorizzato quando status passa a "done"; i task done vengono eliminati 30 giorni dopo
  createdAt   DateTime  @default(now())

  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]

  @@index([clientId])
  @@index([status, completedAt])
}

// Join table assegnatari task <-> utenti
model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}
