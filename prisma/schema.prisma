// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Membro del team
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("membro") // super_admin | membro (da non confondere con employmentType)
  employmentType String   @default("dipendente") // dipendente | partita_iva
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  // "sub" dell'account Keycloak (OIDC). Valorizzato al primo login SSO: da lì
  // l'utente è legato a quell'account, non più all'email.
  oidcSubject    String?  @unique

  sessions               Session[]          @relation("SessionOwner")
  impersonatedIn         Session[]          @relation("SessionImpersonated")
  impersonationsDone     ImpersonationLog[] @relation("ImpersonationAdmin")
  impersonationsReceived ImpersonationLog[] @relation("ImpersonationTarget")
  leaveRequests          LeaveRequest[]
  events                 EventParticipant[]
  createdEvents          CalendarEvent[]
  presenceEntries        PresenceEntry[]
  timeEntries            TimeEntry[]
  taskAssignments        TaskAssignee[]
  balanceAdjustments     LeaveBalanceAdjustment[]
  recoveryCredits        RecoveryCredit[]
}

// Sessione di login: token opaco in cookie httpOnly, riga cancellabile per logout/revoca
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Come è nata la sessione: "password" o "oidc" (null = creata prima che si
  // registrasse). Per le sessioni "oidc" "Esci" passa anche da Keycloak.
  authMethod String?
  // Solo sessioni "oidc", cifrati con SETTINGS_ENCRYPTION_KEY: l'id_token serve
  // come id_token_hint per il logout, il refresh_token per verificare ogni 5
  // minuti che la sessione SSO sia ancora attiva (ssoCheckedAt = ultima verifica).
  idToken      String?
  refreshToken String?
  ssoCheckedAt DateTime?

  // Impersonificazione in sola lettura (solo super admin): finché è
  // valorizzato, l'app mostra le pagine come le vede questo utente. Nessuna
  // scadenza propria: si chiude con "Torna al tuo profilo" o con il logout.
  impersonatedUserId String?

  user             User  @relation("SessionOwner", fields: [userId], references: [id], onDelete: Cascade)
  impersonatedUser User? @relation("SessionImpersonated", fields: [impersonatedUserId], references: [id], onDelete: SetNull)
}

// Registro delle impersonificazioni: chi ha visto l'app come chi, e per quanto.
// endedAt resta vuoto finché la sessione è in corso (o se la sessione è
// scaduta senza uscita esplicita). sessionId non è una relazione: la sessione
// viene cancellata al logout, il registro deve restare.
model ImpersonationLog {
  id           String    @id @default(cuid())
  adminId      String
  targetUserId String
  sessionId    String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  admin      User @relation("ImpersonationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([startedAt])
}

// Richiesta di ferie / permesso / malattia
model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  type      String // ferie | permesso | malattia
  startDate DateTime
  endDate   DateTime
  hours     Float? // valorizzato solo per type = "permesso"
  status    String   @default("pending") // pending | approved | rejected | registrata
  note      String?
  createdAt DateTime @default(now())
  // Solo per type = "recupero": quale recupero da fare sta smaltendo.
  recoveryCreditId String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCredit RecoveryCredit? @relation(fields: [recoveryCreditId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startDate, endDate])
  @@index([recoveryCreditId])
}

// Rettifica del saldo ferie/permessi/assenze, impostata dal super admin
// (es. per allineare i residui tenuti finora su Excel). amount si somma al
// monte annuale dell'anno indicato. Per i dipendenti (ferie, permesso) l'anno
// della rettifica fa da punto di partenza: da lì il residuo si riporta di anno
// in anno. Per le partite IVA (assenze) vale solo per quell'anno.
model LeaveBalanceAdjustment {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  kind      String // ferie | permesso | assenze
  amount    Float
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, kind])
}

// Recupero da fare (es. 2 giorni dopo una trasferta), registrato dal super
// admin. Le richieste di recupero approvate collegate lo smaltiscono: lo stato
// (da fare / in parte / fatto) si calcola da lì, salvo che il super admin lo
// forzi con statusOverride.
model RecoveryCredit {
  id             String   @id @default(cuid())
  userId         String
  reason         String
  amount         Float
  unit           String // giorni | ore
  earnedOn       DateTime
  statusOverride String? // da_fare | fatto; null = calcolato dalle richieste
  createdAt      DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]

  @@index([userId])
}

// Evento di calendario: riunione di team, shooting, altro
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  type        String // riunione | shooting | altro
  startAt     DateTime
  endAt       DateTime
  location    String?
  description String?
  createdById String? // chi ha creato l'evento può sempre gestirlo, anche se non partecipa
  createdAt   DateTime @default(now())

  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  participants EventParticipant[]
}

// Join table partecipanti evento <-> utenti
model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// Autodichiarazione giornaliera di presenza (ufficio/smartworking), senza approvazione
model PresenceEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  slot      String // mattina | pomeriggio | giornata_intera
  mode      String // ufficio | smartworking
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, slot])
}

// Cliente = progetto (1:1 per ora)
model Client {
  id         String   @id @default(cuid())
  name       String   @unique
  active     Boolean  @default(true)
  categories String   @default("") // CSV di categorie: comunicazione | it_design | produzione
  createdAt  DateTime @default(now())

  timeEntries TimeEntry[]
  tasks       Task[]
}

// Log ore lavorate su un cliente/progetto
model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  date        DateTime
  hours       Float
  description String
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([clientId])
}

// Task assegnato a uno o più membri del team, opzionalmente legato a un cliente
model Task {
  id          String    @id @default(cuid())
  title       String
  clientId    String?
  status      String    @default("not_started") // not_started | in_progress | in_pausa | done
  priority    String? // low | medium | high
  dueDate     DateTime?
  completedAt DateTime? // valorizzato quando status passa a "done"; i task done vengono eliminati 30 giorni dopo
  createdAt   DateTime  @default(now())

  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]

  @@index([clientId])
  @@index([status, completedAt])
}

// Join table assegnatari task <-> utenti
model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

// Impostazioni email (una sola riga, id = 1), gestite dai super admin.
// La password SMTP è cifrata con SETTINGS_ENCRYPTION_KEY (vedi
// src/lib/crypto/secret-box.ts): una copia del DB da sola non la rivela.
model EmailSettings {
  id                Int      @id // sempre 1
  enabled           Boolean  @default(false)
  host              String   @default("")
  port              Int      @default(587)
  security          String   @default("starttls") // starttls | tls | none
  username          String   @default("")
  passwordEncrypted String?
  fromAddress       String   @default("")
  fromName          String   @default("Softuerino")
  appUrl            String   @default("") // per i link nelle email
  updatedAt         DateTime @updatedAt
}
